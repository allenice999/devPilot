POSTGRES_DB=devpilot
POSTGRES_USER=devpilot
POSTGRES_PASSWORD=devpilot

# The browser runs outside Docker, so this address must be reachable from the host.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Week 2: use mock without API keys; set deepseek or qwen to use a real model.
LLM_PROVIDER=mock
LLM_FALLBACK_PROVIDER=
LLM_ALLOW_MOCK_FALLBACK=true
LLM_CONTEXT_WINDOW=32768
LLM_CONNECT_TIMEOUT_SECONDS=8
LLM_READ_TIMEOUT_SECONDS=60
MOCK_DELAY_MS=10

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

